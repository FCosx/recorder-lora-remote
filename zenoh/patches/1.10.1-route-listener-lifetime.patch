 //   ZettaScale Zenoh Team, <zenoh@zettascale.tech>
 //
 use cyclors::{qos::*, DDS_LENGTH_UNLIMITED};
+
+// Recorder camera streams represent live frames. A driver using SYSTEM_DEFAULT
+// can resolve to TRANSIENT_LOCAL, causing two bridge caches to replay the same
+// old frame on each recording. Apply this on both DDS hops; changing only a
+// rosbag subscription does not suppress Zenoh's historical fetch.
+// Keep calibration, TF, maps and every non-image type's durability unchanged.
+pub fn live_image_qos(ros2_type: &str, qos: &mut Qos) {
+    if matches!(ros2_type, "sensor_msgs/msg/Image" | "sensor_msgs/msg/CompressedImage") {
+        qos.durability = Some(Durability { kind: DurabilityKind::VOLATILE });
+        qos.durability_service = None;
+    }
+}
+
+#[cfg(test)]
+mod recorder_tests {
+    use super::*;
+
+    #[test]
+    fn live_images_do_not_replay_history() {
+        for typ in ["sensor_msgs/msg/Image", "sensor_msgs/msg/CompressedImage"] {
+            let mut qos = Qos::default();
+            qos.durability = Some(Durability { kind: DurabilityKind::TRANSIENT_LOCAL });
+            qos.durability_service = Some(DurabilityService::default());
+            live_image_qos(typ, &mut qos);
+            assert!(!is_transient_local(&qos));
+            assert!(qos.durability_service.is_none());
+        }
+    }
+
+    #[test]
+    fn other_retained_topics_keep_their_semantics() {
+        for typ in ["sensor_msgs/msg/CameraInfo", "tf2_msgs/msg/TFMessage",
+                    "nav_msgs/msg/OccupancyGrid", "std_msgs/msg/String"] {
+            let mut qos = Qos::default();
+            qos.durability = Some(Durability { kind: DurabilityKind::TRANSIENT_LOCAL });
+            qos.durability_service = Some(DurabilityService::default());
+            live_image_qos(typ, &mut qos);
+            assert!(is_transient_local(&qos));
+            assert!(qos.durability_service.is_some());
+        }
+    }
+}
 
